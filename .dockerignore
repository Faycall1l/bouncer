# T062+T718: keep the build context tiny — the image COPYs only
# pyproject.toml, README.md, LICENSE, MANIFEST.in and src/.
# git history
.git
.gitignore
.venv
# weights + their cache (never inside an image layer)
models/
hf-cache/
# data dumps (jsonl exports, dataset material, stats)
data/
*.jsonl
bouncer-stats.json
# bytecode, anywhere in the tree
**/__pycache__
**/*.pyc
__pycache__
*.pyc
# secrets
.env
# local build artifacts (T982: sdist/wheel keep these out — T962 —
# and so does the image context: no layer can carry stale output)
build/
dist/
site/
*.egg-info
